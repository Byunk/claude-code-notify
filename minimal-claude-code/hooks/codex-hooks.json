{
  "description": "Notify when Codex needs your attention",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'script=$(ls -dt \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/minimal-claude-code/minimal-claude-code\"/*/hooks/scripts/notify.js 2>/dev/null | head -n 1); [ -n \"$script\" ] && exec node \"$script\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'script=$(ls -dt \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/minimal-claude-code/minimal-claude-code\"/*/hooks/scripts/notify.js 2>/dev/null | head -n 1); [ -n \"$script\" ] && exec node \"$script\"'"
          }
        ]
      }
    ]
  }
}
